# Tyto hodnoty nastav v prostředí serveru. Soubor .env se automaticky nenačítá.
FORMA_PUBLIC_URL=https://your-domain.example
FORMA_HOST=0.0.0.0
FORMA_ENV=production
FORMA_DATA=/data
PORT=8765
# Ochrany veřejného bezplatného náhledu; 0 u prvních tří znamená bez limitu.
FORMA_MAX_ACCOUNTS=25
FORMA_MAX_PHOTO_MB_PER_ACCOUNT=25
FORMA_MAX_TOTAL_PHOTO_MB=250
FORMA_WRITE_RATE_PER_MINUTE=60
# Volitelné AI: vlastní serverový klíč, nikdy jej nevkládej do app.js ani do chatu.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# 0 drží placená AI volání vypnutá.
FORMA_AI_DAILY_LIMIT=0
